   "id": "neutral",
   "type": "neutral",
   "name": "Neutral is neutral",
   "about": "A standing normal recorded at neutral needs neutral or another standing-normal direction (below), not any direction: forward + a button is a command normal for many characters.",
   "source": {
    "verified": true,
    "note": "SuperCombo Wiki, Street Fighter 6 Data pages (patch 2.05), read 2026-10-14 (command normals)"
   }
  },
